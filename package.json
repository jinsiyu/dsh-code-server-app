{
  "name": "dsh-code-server-app",
  "version": "0.1.32",
  "description": "Integrate code-server (VS Code in the browser) into DSH Web and Desktop: right-sidebar tab (DSH >= 0.1.5-alpha.1) with a floating-ball fallback for older hosts, over the Connection /api channel (ctx.connection.fetch; no webServer dependency) with host-side process lifecycle.",
  "homepage": "https://github.com/jinsiyu/dsh-code-server-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinsiyu/dsh-code-server-app.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "env": {
      "minVersion": "0.1.5-alpha.1"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.2-rc.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "assets/favicon.ico",
    "assets/favicon.svg",
    "assets/extensions/dshcs-open-file",
    "scripts/setup-code-server.mjs",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "setup:code-server": "node scripts/setup-code-server.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "motion": "^12.0.0"
  },
  "license": "MIT",
  "allowScripts": {
    "code-server": false,
    "argon2": true,
    "unrs-resolver": true
  }
}
