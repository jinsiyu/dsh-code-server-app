{
  "name": "dshcs-editor-bridge",
  "displayName": "DSH Editor Bridge",
  "description": "对工作区只读地把编辑器状态(未保存缓冲区、诊断、活动选区)提供给 DSH(不写文件、不执行命令);右键提问打开 DSH 页面里的悬浮对话对话框(0.3.59 起是唯一路径:面板在插件客户端半部,正文/思考/上下文都用页面模块表里的官方渲染器,并可就地回答授权请求;拿不到对话框心跳时只给一条提示)。由 dsh-code-server-app 插件安装,可禁用。另有**实验性**的 FIM 内联补全(灰字续写):默认关闭,在插件设置卡里开启;关闭时本扩展连 provider 都不注册,不会发出任何补全请求。",
  "version": "0.2.20",
  "publisher": "dsh-code-server-app",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dsh-code-server.askAboutSelection",
        "title": "DSH: 针对选中内容提问",
        "category": "DSH"
      },
      {
        "command": "dsh-code-server.askAboutFile",
        "title": "DSH: 针对当前文件提问",
        "category": "DSH"
      },
      {
        "command": "dsh-code-server.showBridgeLog",
        "title": "DSH: 显示编辑器桥日志",
        "category": "DSH"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dsh-code-server.askAboutSelection",
          "when": "editorHasSelection",
          "group": "navigation@-2"
        },
        {
          "command": "dsh-code-server.askAboutFile",
          "group": "navigation@-1"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "本扩展只向本机 DSH 读取/上报编辑器状态,不修改工作区文件。"
    },
    "virtualWorkspaces": true
  }
}
