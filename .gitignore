# 依赖与构建产物
node_modules/
*.tgz
.pnpm-store/
.pnpm-store-local/
# pnpm 的仓库本地 store(--store-dir .store;见 pnpm-workspace.yaml 的说明)
.store/
# 锁文件**要入库**(2026-09 起):CI(.github/workflows)用 `pnpm install --frozen-lockfile`
# 做可复现安装,actions/setup-node 的 pnpm 缓存也按它算 key。它不在 package.json 的 files 白名单里
# → 不会进 npm 发布物,只影响仓库自身的开发安装。

# 打包期内置产物:由 `pnpm run vendor:vscode` 生成(见 scripts/vendor-vscode-server.mjs),
# 不入 git,但**必须**随 npm 包发布(package.json 的 files 含 vendor/VENDOR.json;
# VS Code 树本体由 @jinsiyu/dshcs-vscode-server 提供)。
vendor/
# 预编译原生包的重打包工作区(生成物):scripts/vendor-repacks.mjs → repack/{build,aggregator,tgz}
repack/
.vendor-tmp/
.npm-cache/

# 本地临时验证脚本与工程(.tmp-*)与一次性验证 harness(spike-*)
.tmp-*
spike-*.mjs
# 验证过程的中间产物:日志、证据、测试用 user-data(scripts/*.mjs 产出)
.spike/

# client bundle 构建产物:由 src/factory.js 经 `pnpm run build:client` 生成,
# 仓库只跟踪源码与构建脚本(scripts/build-client.mjs)。
lib/client.js

# 「问 DSH」面板 webview 的构建产物:由 scripts/build-webview.mjs 生成
# (官方渲染器 + 面板外壳),同样只跟踪源码与构建脚本。
assets/extensions/dshcs-editor-bridge/webview/thread.js
assets/extensions/dshcs-editor-bridge/webview/thread.css
assets/extensions/dshcs-editor-bridge/webview/fonts/
assets/extensions/dshcs-editor-bridge/webview/THIRD-PARTY.md
# 从官方发布物里抽出来的设计令牌表(生成物)
assets/extensions/dshcs-editor-bridge/webview/src/official-tokens.css
# webview 打包的中间产物(替身模块 / esbuild metafile)
.tmp-webview/

# code-server 运行期数据(扩展/用户数据/pid 等,由插件生成)
code-server/

# 日志与缓存
*.log
npm-debug.log*
pnpm-debug.log*
.pnpm-cache/
.npm-cache/

# 本地 npm 凭据(发布用 token 等;绝不入库)
.npmrc

# 编辑器与系统
.DS_Store
Thumbs.db
desktop.ini

# 临时评审/验证脚本(如 verify-host.mjs 等一次性脚本)
verify-*.mjs

# DSH 会话数据(插件运行期产物,不纳入仓库)
.mnemon/

# 本地验证用的 file: 包(scripts/spike-build-local-pkgs.mjs 产出;发布 0.2.0 后可删)
local-pkgs/
