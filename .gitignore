# 依赖与构建产物
node_modules/
*.tgz
.pnpm-store/
.pnpm-store-local/
pnpm-lock.yaml

# 打包期内置产物:由 `pnpm run vendor:code-server` 生成(见 scripts/vendor-code-server.mjs),
# 不入 git,但**必须**随 npm 包发布(package.json 的 files 已包含 vendor/code-server)。
vendor/
# 预编译原生包的重打包工作区(生成物):scripts/vendor-repacks.mjs → repack/{build,aggregator,tgz}
repack/
.vendor-tmp/
.npm-cache/

# 本地临时验证脚本与工程(.tmp-*)
.tmp-*

# client bundle 构建产物:由 src/factory.js 经 `pnpm run build:client` 生成,
# 仓库只跟踪源码与构建脚本(scripts/build-client.mjs)。
lib/client.js

# code-server 运行期数据(扩展/用户数据/pid 等,由插件生成)
code-server/

# 日志与缓存
*.log
npm-debug.log*
pnpm-debug.log*
.pnpm-cache/
.npm-cache/

# 本地 npm 凭据(发布用 token 等;绝不入库)
.npmrc

# 编辑器与系统
.DS_Store
Thumbs.db
desktop.ini

# 临时评审/验证脚本(如 verify-host.mjs 等一次性脚本)
verify-*.mjs

# DSH 会话数据(插件运行期产物,不纳入仓库)
.mnemon/
