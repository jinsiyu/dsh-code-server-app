# 依赖与构建产物
node_modules/
*.tgz
.pnpm-store/
.pnpm-store-local/
pnpm-lock.yaml
# pnpm 在本包目录自动生成的构建许可占位文件(esbuild 等)
pnpm-workspace.yaml

# client bundle 构建产物:由 src/factory.js 经 `pnpm run build:client` 生成,
# 仓库只跟踪源码与构建脚本(scripts/build-client.mjs)。
lib/client.js

# code-server 运行期数据(扩展/用户数据/pid 等,由插件生成)
code-server/

# 日志与缓存
*.log
npm-debug.log*
pnpm-debug.log*
.pnpm-cache/
.npm-cache/

# 编辑器与系统
.DS_Store
Thumbs.db
desktop.ini

# 临时评审/验证脚本(如 verify-host.mjs 等一次性脚本)
verify-*.mjs

# DSH 会话数据(插件运行期产物,不纳入仓库)
.mnemon/
